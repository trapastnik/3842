{
  "defaultScene": "map-hier",
  "defaultLang": "ru",
  "timings": {
    "fade": 350,
    "reset": 90,
    "standby": 180,
    "restartAt": "04:00",
    "standbyFps": 10
  },
  "nav": {
    "show": true,
    "position": "bottom",
    "layout": "bar",
    "sideY": 50,
    "sideX": 64,
    "size": 96,
    "opacity": 0.92,
    "showTitle": true,
    "showArrows": true,
    "showDots": true
  },
  "stripes": { "on": true, "opacity": 1, "angle": 105 },
  "scale": { "ui": 1, "content": 1 },
  "content": { "width": 100, "height": 100 },
  "i18n": { "langs": ["ru", "en", "zh"], "show": true },
  "a11y": { "enabled": false, "show": true, "uiBoost": 1.25, "contentBoost": 1.5 },
  "tools": { "position": "top-left" },
  "service": { "gear": "always" },
  "watchdog": { "stallSec": 30, "sceneTimeoutSec": 20, "restart": true, "journalLimit": 200 }
}
